{
  "$note": "REKA design tokens, transcribed from brand-guidelines.html v1.0 and its ai-docs exports (June 2026). The guidelines file is the master: change it first, then this file and tokens.css.",
  "version": "1.0.0",
  "color": {
    "orange": {
      "brand": { "value": "#FB9800", "cmyk": "C0 M39 Y100 K2", "use": "The one official orange. Marks, fills, primary actions, headlines on dark. Never body text on light." },
      "highlight": { "value": "#FFB23E", "cmyk": "C0 M30 Y76 K0", "use": "Hover and glow on dark surfaces" },
      "secondary": { "value": "#E65D01", "cmyk": "C0 M60 Y100 K10", "use": "Pressed state, dark end of orange gradients, amber inline text on light" },
      "retired": ["#f7941d", "#E07D10", "#E8742A", "#FFA910", "#0062FB"]
    },
    "public": {
      "$note": "Light-first public surfaces (website, client portal, documents for clients)",
      "bg": { "value": "#F7F6F3" },
      "panel": { "value": "#FFFFFF" },
      "line": { "value": "#E5E4E1" },
      "ink": { "value": "#1D1D1D" },
      "ink-2": { "value": "#565656" },
      "ink-3": { "value": "#9A9A9A" }
    },
    "internal": {
      "$note": "Dark surfaces for internal tools, the brand kit, splash screens and HUD/Mecha expressions",
      "near-black": { "value": "#0B0B0C", "cmyk": "C8 M8 Y0 K95" },
      "surface": { "value": "#161618", "cmyk": "C8 M8 Y0 K91" },
      "surface-2": { "value": "#1D1D20", "cmyk": "C9 M9 Y0 K87" },
      "border": { "value": "#26262C" },
      "ink": { "value": "#F1F1F0", "cmyk": "C0 M0 Y0 K5" },
      "ink-2": { "value": "#B9B9BD", "cmyk": "C2 M2 Y0 K26" },
      "mute": { "value": "#76767C", "cmyk": "C5 M5 Y0 K51" }
    },
    "stripe-cream": { "value": "#F2E8D5", "cmyk": "C0 M4 Y12 K5", "use": "Official document stripe, with orange" },
    "proportion": { "near-black": "70%", "surfaces": "20%", "orange": "10% maximum" },
    "division": {
      "$note": "Each division owns one colour family; its flagship product inherits it. Primaries marked tbc are placeholders in the guidelines.",
      "harmonik": { "product": "PLExyz", "light": "#C8BDE8", "mid": "#865ACE", "primary": "#6040CC", "dark": "#281B4F", "sidebar": "#241E58", "status": "primary tbc in ai-docs; locked in brand-guidelines.html" },
      "kinetik": { "product": "OVERride", "light": "#BAE4E1", "mid": "#6AD1BF", "primary": "#1AB89C", "dark": "#063028", "sidebar": "#063028", "status": "primary tbc in ai-docs; locked in brand-guidelines.html" },
      "heuristik": { "product": "AntaraX", "light": "#6AAEFF", "mid": "#0496FF", "primary": "#1268F7", "dark": "#16366B", "sidebar": "#0D2850" },
      "esoterik": { "product": "Tinara", "light": "#CAB9C7", "mid": "#8D6885", "primary": "#501643", "dark": "#2D0A22", "sidebar": "#2D0A22" },
      "operations": { "product": "REKA internal console and client portal", "primary": "#FB9800", "sidebar": "#1A0E00" }
    },
    "internal-tagging": { "products": "#274677", "services": "#501643", "external": "#FFFFFF", "internal": "#0B0B0C", "use": "Internal documents only, never public UI" },
    "accent-illustration-only": {
      "neon": ["#00B3FF", "#00F0FF", "#3B72FF", "#FF5689", "#FF5757", "#FF7A00"],
      "pastel": ["#ABC1F9", "#CBE2F7", "#ABE1F8", "#A6F3F8", "#F8CEDA", "#F9B6B6", "#F7DCC4"]
    }
  },
  "font": {
    "ui": { "value": "'Poppins', system-ui, sans-serif", "weights": [300, 400, 500, 600, 700, 800] },
    "mono": { "value": "'JetBrains Mono', ui-monospace, monospace", "weights": [400, 500, 700], "use": "Labels, figures, code, telemetry; uppercase, tracked 0.08–0.14em" }
  },
  "type": {
    "hero": "clamp(2.4rem, 4vw, 4rem) / 800 / 1.0",
    "h1": "clamp(2rem, 3vw, 3rem) / 700 / 1.05",
    "h2": "clamp(1.5rem, 2vw, 2.2rem) / 700 / 1.1",
    "h3": "1.3rem / 600 / 1.2",
    "h4": "1rem / 600 / 1.3",
    "body": "0.95–1rem / 400 / 1.55–1.6",
    "small": "0.8–0.88rem / 400 / 1.5",
    "label": "0.62–0.72rem / 500 / 1, mono uppercase tracked",
    "data": "1.5–2rem / 600–700 / 1, mono"
  },
  "shape": {
    "rule": "Chamfer cuts, not border-radius. Exceptions: nav pills (8px) and avatar circles.",
    "chamfer": { "micro": "7px", "panel": "9px", "hero": "12px", "screen-frame": "24px, top-right corner only" }
  },
  "texture": {
    "dot-grid-light": "radial-gradient(circle, rgba(0,0,0,.06) 1px, transparent 1px) / 20px 20px",
    "dot-grid-dark": "radial-gradient(circle, rgba(255,255,255,.042) 1px, transparent 1px) / 20px 20px"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.85,.2,1)",
    "micro": "120–150ms ease-out",
    "panel": "250–300ms",
    "live-dot": "2s ease-in-out infinite, opacity 1 to .25 to 1",
    "hud-spin": "slow and continuous (12s in ai-docs, about 46s in brand-guidelines.html)",
    "rule": "Boot, don't bounce. Animate opacity and transform only. Everything off under prefers-reduced-motion."
  },
  "logo": {
    "clear-space": "X on every side, X = height of the logomark",
    "minimum": { "mark-ui": "24px", "mark-comfortable": "40px", "lockup-screen": "22px tall", "lockup-print": "about 16mm wide" }
  }
}
